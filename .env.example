# Copy this file to `.env` and fill in per-developer values.
# `.env` is git-ignored so secrets never get committed.

# Which environment file under config/environments/ to load (dev | qa | prod)
TEST_ENV=dev

# Optional overrides (take precedence over the YAML env files)
API_BASE_URL=
API_TOKEN=
API_USERNAME=
API_PASSWORD=

# Networking
HTTP_TIMEOUT_MS=30000
IGNORE_HTTPS_ERRORS=false

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
